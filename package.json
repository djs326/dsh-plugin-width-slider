{
  "name": "dsh-plugin-width-slider",
  "displayName": "Width Slider · 对话宽度与思考增强",
  "description": "DSH 个人多功能插件：对话宽度滑块 + 思考块增强（思考/回复强制中文、思考块展开收起与 Markdown 渲染，收编 dsh-think-zh-expand）+ 界面英文中文化 + 官方设置面板补丁（弹窗调宽 / tab 滚动），全部功能独立开关。Settings-panel feature control page with a width slider, thinking-block enhancements and settings-panel UI patches — every feature has its own toggle.",
  "version": "0.3.0",
  "license": "MIT",
  "type": "module",
  "main": "lib/index.mjs",
  "types": "lib/types/index.d.ts",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./lib/types/index.d.ts",
      "default": "./lib/index.mjs"
    },
    "./client": {
      "types": "./lib/types/client/index.d.ts",
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "dsh": {
    "engines": {
      "dsh": ">=0.1.1-rc.1"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-connection"
      ],
      "platform": "web",
      "external": [
        "dsh-md-render"
      ]
    }
  },
  "scripts": {
    "build": "tsdown && tsc -p tsconfig.json && node scripts/fix-dts-imports.mjs",
    "prepack": "npm run build",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "width",
    "slider",
    "conversation-width",
    "resize"
  ],
  "publishConfig": {
    "access": "public",
    "provenance": false
  },
  "engines": {
    "node": "^22.11 || >=24"
  },
  "os": [
    "win32"
  ],
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1-rc.1",
    "@deepseek-ai/dsh-client-connection": "*",
    "@deepseek-ai/dsh-client-locale": "*",
    "@deepseek-ai/dsh-client-runtime": "*",
    "@deepseek-ai/dsh-client-ui-conversation": "*",
    "@deepseek-ai/dsh-client-ui-primitives": "*",
    "@deepseek-ai/dsh-client-ui-slots": "*",
    "react": "^18.2.0",
    "@deepseek-ai/dsh-system-prompt": "^0.1.1-rc.1",
    "dsh-md-render": "^0.1.1"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-connection": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-locale": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-runtime": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-conversation": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-primitives": {
      "optional": true
    },
    "@deepseek-ai/dsh-client-ui-slots": {
      "optional": true
    },
    "react": {
      "optional": true
    },
    "@deepseek-ai/dsh-system-prompt": {
      "optional": true
    },
    "dsh-md-render": {
      "optional": true
    }
  },
  "devDependencies": {
    "@types/node": "^22.19.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "rolldown": "^1.2.6",
    "tsdown": "^0.22.14",
    "typescript": "^5.7.0"
  },
  "author": "Lanxi",
  "repository": {
    "type": "git",
    "url": "https://github.com/djs326/dsh-plugin-width-slider.git"
  },
  "homepage": "https://github.com/djs326/dsh-plugin-width-slider#readme",
  "bugs": {
    "url": "https://github.com/djs326/dsh-plugin-width-slider/issues"
  }
}
